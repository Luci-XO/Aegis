# Copy to .env and fill in. Never commit real values (.env is in .gitignore).

# HMAC key for approval tokens: hex string, at least 64 hex characters (32 bytes).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, Aegis uses a random key per process (tokens stop working on restart).
AEGIS_APPROVAL_SECRET=

# Path to the SQLite audit log (used from Stage 4 onward).
AEGIS_AUDIT_DB=./aegis_audit.sqlite

# Optional LLM provider. Leave AEGIS_LLM_PROVIDER empty to use the scripted agent.
# Providers with a built-in base URL: openai, ollama. Any OpenAI-compatible API
# works by setting AEGIS_LLM_BASE_URL explicitly.
#
# OpenAI:
#   AEGIS_LLM_PROVIDER=openai
#   AEGIS_LLM_MODEL=gpt-4o-mini
#   AEGIS_LLM_API_KEY=<your key>
#
# Local via Ollama (no key needed):
#   AEGIS_LLM_PROVIDER=ollama
#   AEGIS_LLM_MODEL=llama3
AEGIS_LLM_PROVIDER=
AEGIS_LLM_BASE_URL=
AEGIS_LLM_MODEL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_TEMPERATURE=0
# Raise if a "thinking" model returns cut-off answers.
AEGIS_LLM_MAX_TOKENS=4096
