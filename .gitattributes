# Keep LF line endings on every OS so content hashes (aegis/eval/freeze.json,
# benchmark provenance, the single-file bundle) match on Windows too.
* text=auto eol=lf
*.png binary
*.ico binary
*.pdf binary
*.pptx binary
*.zip binary
*.jpg binary
*.jpeg binary
*.gif binary
# Windows batch files must keep CRLF line endings to run reliably.
*.bat text eol=crlf
*.sh text eol=lf
